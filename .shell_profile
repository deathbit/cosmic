# ============================================================
# .shell_profile — shared login shell config (bash & zsh)
# ============================================================

# ── Environment ─────────────────────────────────────────────
export EDITOR='vim'
export VISUAL='vim'
export PAGER='less'
export LANG='en_US.UTF-8'
export LC_ALL='en_US.UTF-8'

# ── PATH ────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

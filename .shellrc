# ══════════════════════════════════════════════════════════════════════════════
# ALIAS
# ══════════════════════════════════════════════════════════════════════════════

alias ll='ls -al --color'

# ══════════════════════════════════════════════════════════════════════════════
# PROXY
# ══════════════════════════════════════════════════════════════════════════════

proxy_on() {
    local http_port socks5_port

    if [ "$(uname -s)" = "Darwin" ]; then
        http_port=7890
        socks5_port=1080
    else
        http_port=10809
        socks5_port=10808
    fi

    export http_proxy="http://127.0.0.1:${http_port}"
    export https_proxy="http://127.0.0.1:${http_port}"
    export ftp_proxy="http://127.0.0.1:${http_port}"
    export all_proxy="socks5h://127.0.0.1:${socks5_port}"
    export no_proxy="localhost,127.0.0.1,::1"

    export HTTP_PROXY="http://127.0.0.1:${http_port}"
    export HTTPS_PROXY="http://127.0.0.1:${http_port}"
    export FTP_PROXY="http://127.0.0.1:${http_port}"
    export ALL_PROXY="socks5h://127.0.0.1:${socks5_port}"
    export NO_PROXY="localhost,127.0.0.1,::1"
}

proxy_off() {
    unset http_proxy
    unset https_proxy
    unset ftp_proxy
    unset all_proxy
    unset no_proxy

    unset HTTP_PROXY
    unset HTTPS_PROXY
    unset FTP_PROXY
    unset ALL_PROXY
    unset NO_PROXY
}

proxy_test() {
    :
}

proxy_info() {
    :
}

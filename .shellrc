alias ll='ls -al --color'

# ══════════════════════════════════════════════════════════════════════════════
# Proxy - 代理开启/关闭/测试
# ══════════════════════════════════════════════════════════════════════════════

# Proxy - 开启代理，支持 http/socks5，可选参数覆盖默认地址
proxy_on() {
    local addr="${1:-http://127.0.0.1:7890}"
    export http_proxy="$addr" https_proxy="$addr" all_proxy="$addr"
    export HTTP_PROXY="$addr" HTTPS_PROXY="$addr" ALL_PROXY="$addr"
    echo "✅ 代理已开启: $addr"
}

# Proxy - 开启 socks5 代理
proxy_socks5() {
    proxy_on "${1:-socks5://127.0.0.1:7890}"
}

# Proxy - 关闭代理
proxy_off() {
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    echo "❌ 代理已关闭"
}

# Proxy - 设置不走代理的地址
proxy_noproxy() {
    local list="${1:-localhost,127.0.0.1,::1,10.*,192.168.*}"
    export no_proxy="$list" NO_PROXY="$list"
    echo "🚫 不走代理: $list"
}

# Proxy - 测试连通性
proxy_test() {
    local target="${1:-https://www.google.com}"
    local result
    result=$(curl -s -o /dev/null -w "%{http_code} %{time_total}s" --connect-timeout 5 "$target" 2>/dev/null)
    local rc=$?
    if [ $rc -eq 0 ]; then echo "✅ $target -> $result"
    else echo "❌ $target -> 连接失败"; return 1; fi
}

# Proxy - 查看当前代理配置
proxy_info() {
    echo "📋 当前代理配置:"
    echo "   http_proxy  = ${http_proxy:-(未设置)}"
    echo "   https_proxy = ${https_proxy:-(未设置)}"
    echo "   all_proxy   = ${all_proxy:-(未设置)}"
    echo "   no_proxy    = ${no_proxy:-(未设置)}"
}

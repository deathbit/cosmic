alias ll='ls -al --color'

# Proxy functions
proxy_on() {
  local proxy="${1:-http://127.0.0.1:7890}"
  export http_proxy="$proxy"
  export https_proxy="$proxy"
  export all_proxy="$proxy"
  export HTTP_PROXY="$proxy"
  export HTTPS_PROXY="$proxy"
  export ALL_PROXY="$proxy"
  echo "Proxy enabled: $proxy"
}

proxy_off() {
  unset http_proxy https_proxy all_proxy
  unset HTTP_PROXY HTTPS_PROXY ALL_PROXY
  echo "Proxy disabled"
}

proxy_test() {
  local url="${1:-https://www.google.com}"
  echo "Testing proxy connectivity to $url ..."
  if ! command -v curl &>/dev/null; then
    echo "Error: curl is not installed" >&2
    return 1
  fi
  curl -s -o /dev/null -w "HTTP Status: %{http_code}\nTime: %{time_total}s\n" "$url"
  local ret=$?
  if [ $ret -ne 0 ]; then
    echo "Error: curl failed with exit code $ret" >&2
    return $ret
  fi
}

proxy_info() {
  echo "http_proxy=${http_proxy:-<unset>}"
  echo "https_proxy=${https_proxy:-<unset>}"
  echo "all_proxy=${all_proxy:-<unset>}"
  echo "HTTP_PROXY=${HTTP_PROXY:-<unset>}"
  echo "HTTPS_PROXY=${HTTPS_PROXY:-<unset>}"
  echo "ALL_PROXY=${ALL_PROXY:-<unset>}"
}

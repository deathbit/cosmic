# ══════════════════════════════════════════════════════════════════════════════
# ALIAS
# ══════════════════════════════════════════════════════════════════════════════

alias ll='ls -al --color'

# ══════════════════════════════════════════════════════════════════════════════
# PROXY
# ══════════════════════════════════════════════════════════════════════════════

proxy_http_port_default="7890"
proxy_socks_port_default="1080"

proxy_get_system_type() {
    proxy_system_name="$(printf '%s' "${OSTYPE:-$(uname -s 2>/dev/null)}" | tr '[:upper:]' '[:lower:]')"

    case "$proxy_system_name" in
        darwin*)
            proxy_system_type="macos"
            ;;
        msys*|cygwin*|win32*|mingw*)
            proxy_system_type="windows"
            ;;
        *)
            proxy_system_type="default"
            ;;
    esac
}

proxy_set_ports() {
    proxy_get_system_type

    case "$proxy_system_type" in
        macos)
            proxy_http_port="${PROXY_HTTP_PORT_MACOS:-$proxy_http_port_default}"
            proxy_socks_port="${PROXY_SOCKS_PORT_MACOS:-$proxy_socks_port_default}"
            ;;
        windows)
            proxy_http_port="${PROXY_HTTP_PORT_WINDOWS:-$proxy_http_port_default}"
            proxy_socks_port="${PROXY_SOCKS_PORT_WINDOWS:-$proxy_socks_port_default}"
            ;;
        *)
            proxy_http_port="${PROXY_HTTP_PORT_DEFAULT:-$proxy_http_port_default}"
            proxy_socks_port="${PROXY_SOCKS_PORT_DEFAULT:-$proxy_socks_port_default}"
            ;;
    esac
}

proxy_on() {
    proxy_set_ports

    export http_proxy="http://127.0.0.1:${proxy_http_port}"
    export https_proxy="http://127.0.0.1:${proxy_http_port}"
    export ftp_proxy="http://127.0.0.1:${proxy_http_port}"
    export all_proxy="socks5h://127.0.0.1:${proxy_socks_port}"
    export no_proxy="localhost,127.0.0.1,::1"

    export HTTP_PROXY="http://127.0.0.1:${proxy_http_port}"
    export HTTPS_PROXY="http://127.0.0.1:${proxy_http_port}"
    export FTP_PROXY="http://127.0.0.1:${proxy_http_port}"
    export ALL_PROXY="socks5h://127.0.0.1:${proxy_socks_port}"
    export NO_PROXY="localhost,127.0.0.1,::1"
}

proxy_off() {
    unset http_proxy
    unset https_proxy
    unset ftp_proxy
    unset all_proxy
    unset no_proxy

    unset HTTP_PROXY
    unset HTTPS_PROXY
    unset FTP_PROXY
    unset ALL_PROXY
    unset NO_PROXY
}

proxy_test() {
    :
}

proxy_info() {
    :
}
